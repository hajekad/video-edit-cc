# Per-asset-type FUNCTIONAL merge scripts. Smoke #3 shipped a stub for
# add_logo.py that the agent never implemented — became a footgun.
# Now each known asset type emits a working merge script that invokes
# the canonical tool (logo-overlay, pitch-music-fetch, etc.) directly.
# Agent ALSO frees to edit; default is functional out of the box.

MERGE_SCRIPTS = {
    "logo": '''#!/usr/bin/env python3
"""add_logo — composite the dropped brand logo onto every cut*.mp4 in output/.

Calls /opt/claude-config/tools/logo-overlay (baked canonical tool) with the
positioning that covers the renderer's typographic ORLEN-style fallback
(top-left 14% wide at 8% padding). Skips the close-card overlay because
close cards typically carry their own brand typography.

Usage:
    python edit/add_logo.py /assets/<id>/branding/<logo>.png
"""
import argparse, json, pathlib, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "output"
MANIFEST_PATH = ROOT / "manifest.json"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("asset")
    args = ap.parse_args()

    src = pathlib.Path(args.asset).resolve()
    if not src.exists():
        sys.exit(f"logo not found: {src}")

    mp4s = sorted(OUTPUT.glob("cut*.mp4")) or sorted(OUTPUT.glob("*.mp4"))
    if not mp4s:
        sys.exit(f"no mp4 found in {OUTPUT}")

    print(f"applying logo to {len(mp4s)} cuts", file=sys.stderr)
    for mp4 in mp4s:
        with tempfile.NamedTemporaryFile(
            suffix=".mp4", dir=OUTPUT, delete=False
        ) as tf:
            tmp = pathlib.Path(tf.name)
        rc = subprocess.run([
            "logo-overlay", str(mp4), str(src), str(tmp),
            "--bug-w-pct", "14", "--bug-pad-pct", "8", "--no-close",
        ]).returncode
        if rc != 0:
            tmp.unlink(missing_ok=True)
            print(f"  FAIL: {mp4.name}", file=sys.stderr)
            return rc
        tmp.replace(mp4)
        print(f"  OK:   {mp4.name}", file=sys.stderr)

    if MANIFEST_PATH.exists():
        m = json.loads(MANIFEST_PATH.read_text())
        m.setdefault("brand", {})
        m["brand"]["logo_path"] = str(src)
        m["brand"]["pending_dropin"] = False
        MANIFEST_PATH.write_text(json.dumps(m, indent=2) + "\\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
