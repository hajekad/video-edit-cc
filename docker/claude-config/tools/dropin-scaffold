Usage:
    python {merge_script_path} <path-to-asset>
"""
import argparse
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent  # /work/<slug>
EDIT = ROOT / "edit"
MANIFEST_PATH = ROOT / "manifest.json"


def run(cmd):
