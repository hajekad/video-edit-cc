# Generic fallback for asset types that don't have a per-type functional
# implementation yet. Kept honest — prints what needs to happen so the
# agent implements rather than silently shipping "merge stub" output.
GENERIC_MERGE_TEMPLATE = '''#!/usr/bin/env python3
"""add_{asset_type} — merge stub for {asset_type_pretty}.

NO CANONICAL IMPLEMENTATION exists for this asset type yet. Per the
self-extension doctrine in /docs/HARNESS_SELF_EXTENSION.md, your job
when running this is to implement it RIGHT NOW (don't just print and
move on). See /docs/DROPIN_SCAFFOLD_PATTERN.md § Standard asset-type
registry for the canonical merge shape.

After implementing the merge here, also:
1. Promote a generic version to /agents/fsh-tools/<asset_type>-merge so
   future projects inherit it.
2. Update /opt/claude-config/tools/dropin-scaffold MERGE_SCRIPTS dict
   so the next dropin-scaffold call for this asset type emits the
   functional version directly.

Usage:
    python {merge_script_path} <path-to-asset>
"""
import argparse
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
EDIT = ROOT / "edit"
OUTPUT = ROOT / "output"
MANIFEST_PATH = ROOT / "manifest.json"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("asset")
    args = ap.parse_args()

    src = pathlib.Path(args.asset).resolve()
    if not src.exists():
        sys.exit(f"asset not found: {{src}}")

    print(f"NO MERGE IMPLEMENTATION for asset type '{asset_type}'.")
    print("This is a stub. Implement the merge in this file BEFORE shipping.")
    print("See /docs/DROPIN_SCAFFOLD_PATTERN.md + /docs/HARNESS_SELF_EXTENSION.md.")
    return 1  # exit non-zero so the agent NOTICES the stub instead of moving on


if __name__ == "__main__":
    sys.exit(main())
'''


def get_merge_script(asset_type: str, merge_script_path: str) -> str:
    """Return the merge-script source for the given asset type.

    Known types get functional implementations; unknown types get the
    generic template that exits non-zero so the agent's render loop
    notices the gap and implements rather than silently bypassing.
    """
    if asset_type in MERGE_SCRIPTS:
        return MERGE_SCRIPTS[asset_type]
    return GENERIC_MERGE_TEMPLATE.format(
        asset_type=asset_type.replace("-", "_"),
        asset_type_pretty=asset_type.replace("-", " "),
        merge_script_path=merge_script_path,
    )


def emit_scaffold(
    project_slug: str,
    asset_type: str,
    sources: list[str],
    notes: str,
    work_root: Path,
    assets_root: Path,
) -> None:
    if asset_type not in ASSET_TYPES:
        raise SystemExit(
            f"unknown asset-type: {asset_type}. "
            f"Known: {', '.join(ASSET_TYPES)}"
        )
    spec = ASSET_TYPES[asset_type]

    work_dir = work_root / project_slug
    if not work_dir.is_dir():
        raise SystemExit(f"no project workspace at {work_dir}")

    manifest_path = work_dir / "manifest.json"
    manifest = (
        json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
    )
    asset_id = manifest.get("id", project_slug)
    asset_path = Path(manifest.get("asset_path", str(assets_root / asset_id)))

    # 1. Drop folder + README
    asset_type_dir_name = asset_type.replace("-", "_") if asset_type == "license-doc" else asset_type
    if asset_type == "logo":
        asset_type_dir_name = "branding"
    if asset_type == "license-doc":
        asset_type_dir_name = "licenses"
    if asset_type == "client-footage":
        asset_type_dir_name = "raw_addendum"

    drop_dir = asset_path / asset_type_dir_name
    drop_dir.mkdir(parents=True, exist_ok=True)

    merge_script_filename = spec["merge_script_filename"]
    merge_script_path = (
        f"edit/{merge_script_filename}"
        if merge_script_filename and not merge_script_filename.startswith("(")
        else "(no merge script — see manifest)"
    )

    src_list = sources or spec["default_url_hints"]
    source_list_md = "\n".join(f"     - {u}" for u in src_list)

    readme = README_TEMPLATE.substitute(
        asset_type=asset_type,
        asset_type_pretty=asset_type.replace("-", " "),
        drop_filename_glob=spec["drop_filename_glob"],
        drop_dir=str(drop_dir),
        drop_example=spec["drop_examples"][0],
        merge_script_path=merge_script_path,
        merges_into=", ".join(spec["merges_into"]),
        source_list=source_list_md,
        license_note=spec["license_note"],
        notes=f"\n## Project notes\n\n{notes}\n" if notes else "",
    )
    (drop_dir / "README.md").write_text(readme)

    # 2. Merge script — functional per asset type when available, generic
    # exit-non-zero stub otherwise (so the agent NOTICES the gap and
    # implements rather than silently bypassing).
    if merge_script_filename and not merge_script_filename.startswith("("):
        merge_script_full = work_dir / "edit" / merge_script_filename
        if not merge_script_full.exists():
            merge_script_full.write_text(
                get_merge_script(
                    asset_type=asset_type,
                    merge_script_path=f"edit/{merge_script_filename}",
                )
            )
            merge_script_full.chmod(0o755)

    # 3. Manifest update — set pending_dropin flag
    key = asset_type.replace("-", "_")
    manifest.setdefault(key, {})
    manifest[key]["pending_dropin"] = True
    manifest[key]["drop_path"] = str(drop_dir)
    manifest[key]["scaffold_sources"] = src_list
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")

    print(f"drop-in scaffold for '{asset_type}' ready at {drop_dir}")
    print(f"  merge script: {merge_script_path}")
    print(f"  manifest flag: .{key}.pending_dropin = true")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("project_slug")
    ap.add_argument(
        "asset_type",
        choices=sorted(ASSET_TYPES.keys()),
        help="Asset class (extend ASSET_TYPES dict to add more).",
    )
    ap.add_argument(
        "--sources",
        help="Comma-separated list of candidate URLs to include in the README.",
        default="",
    )
    ap.add_argument(
        "--notes",
        help="Free-text notes appended to the README.",
        default="",
    )
    ap.add_argument("--work-root", default="/work")
    ap.add_argument("--assets-root", default="/assets")
    args = ap.parse_args()

    sources = [s.strip() for s in args.sources.split(",") if s.strip()]
    try:
        emit_scaffold(
            args.project_slug,
            args.asset_type,
            sources,
            args.notes,
            Path(args.work_root),
            Path(args.assets_root),
        )
    except SystemExit:
        raise
    except Exception as e:
        print(f"dropin-scaffold failed: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
