# Agent scratch. Top-level ignores this entirely.
#
# work/ is its own independent git repo, and each /work/<id>/ inside it
# is also its own git repo (scaffolded by docker/claude-config/scaffold-project.sh).
# The reason work/ is a repo at all is empirical — long-running Claude
# agents behave noticeably better in cwd's that have a .git/ around
# them. Acts as a behavioral anchor. No upstream, never pushed.
work/

# User IO — videos in, deliverables out. Large binary; gitignored.
assets/

# External reference material — saved articles + arXiv PDF.
# Not our IP; not version-controlled here.
reference/

# Note: agents/ used to be its own git repo (gitignored from top-level).
# As of the agents-merge migration, agents/ is a tracked subdirectory
# of top-level. Its 44 third-party clones are git submodules registered
# in top-level/.gitmodules with paths under agents/<name>.

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
