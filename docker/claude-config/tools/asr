#!/usr/bin/env python3
"""asr — robust ASR wrapper that prefers faster-whisper, escalates to
WhisperX only when diarization is explicitly requested.

Smoke test #2 hit a runtime error when the agent reached for `whisperx`
CLI to transcribe industrial footage: pyannote.audio + torchaudio API
drift in the baked /opt/ml-venv. The agent pivoted to faster-whisper
correctly but lost a couple minutes guessing the right path. This
wrapper makes the right choice automatic.

Decision matrix:
- No diarization needed (single speaker / B-roll / monologue / no
  speakers tagged in brief) → faster-whisper directly. Always works.
- Diarization needed (multi-speaker interview, panel, conversation) →
  try WhisperX. If pyannote import fails, fall back to faster-whisper
  + a note that speaker tags weren't generated.

Outputs WhisperX-compatible JSON so downstream pack_transcripts /
EDL-build tooling doesn't care which engine ran.

Usage:
  asr <input.{mp4,mov,wav,...}> [--language <code>] [--diarize]
                                [--model large-v3] [--out <path>]
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


def run_faster_whisper(src: Path, language: str | None, model_name: str, out_path: Path) -> int:
    from faster_whisper import WhisperModel  # type: ignore

    model_dir = os.environ.get("FSH_WHISPER_MODEL_DIR", "/opt/whisper-models")
    print(f"[asr] faster-whisper backend, model={model_name}, dir={model_dir}", file=sys.stderr)
    model = WhisperModel(
        model_name,
        device="cuda",
        compute_type="float16",
        download_root=model_dir,
    )
    segments, info = model.transcribe(
        str(src),
        language=language,
        word_timestamps=True,
        vad_filter=True,
        vad_parameters={"min_silence_duration_ms": 500},
    )

    # WhisperX-compatible JSON
    result = {
        "language": info.language,
        "language_probability": info.language_probability,
        "duration": info.duration,
        "segments": [],
    }
    for seg in segments:
        words = []
        for w in seg.words or []:
            words.append({
                "start": w.start,
                "end": w.end,
                "word": w.word,
                "probability": w.probability,
            })
        result["segments"].append({
            "id": seg.id,
            "start": seg.start,
            "end": seg.end,
            "text": seg.text,
            "words": words,
        })

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(result, ensure_ascii=False, indent=2))
    print(f"[asr] wrote {out_path} ({len(result['segments'])} segments, "
          f"lang={info.language})", file=sys.stderr)
    return 0


def run_whisperx_with_diarize(src: Path, language: str | None, model_name: str, out_path: Path) -> int:
    """Attempt the WhisperX path. Returns 0 on success, 2 on import-side failure
    so the caller can fall back to faster-whisper."""
    try:
        import whisperx  # type: ignore
    except Exception as e:
        print(f"[asr] WhisperX import failed: {e}", file=sys.stderr)
        return 2

    try:
        import torch  # type: ignore
        device = "cuda" if torch.cuda.is_available() else "cpu"
        print(f"[asr] WhisperX backend (with diarization), device={device}", file=sys.stderr)

        audio = whisperx.load_audio(str(src))
        model = whisperx.load_model(model_name, device, compute_type="float16",
                                    language=language)
        result = model.transcribe(audio, batch_size=8, language=language)

        # Word alignment
        align_model, metadata = whisperx.load_align_model(
            language_code=result["language"], device=device
        )
        result = whisperx.align(result["segments"], align_model, metadata, audio,
                                device, return_char_alignments=False)

        # Diarization
        try:
            from whisperx.diarize import DiarizationPipeline  # type: ignore
            diar = DiarizationPipeline(use_auth_token=None, device=device)
            diar_segments = diar(audio)
            result = whisperx.assign_word_speakers(diar_segments, result)
        except Exception as de:
            print(f"[asr] WhisperX loaded but diarization failed: {de} — "
                  f"writing transcript without speaker tags", file=sys.stderr)

        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(json.dumps(result, ensure_ascii=False, indent=2))
        return 0
    except Exception as e:
        print(f"[asr] WhisperX runtime failed: {e}", file=sys.stderr)
        return 2


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("input", type=Path)
    ap.add_argument("--language", default=None,
                    help="Language code (cs, en, ...). Auto-detect if omitted.")
    ap.add_argument("--diarize", action="store_true",
                    help="Tag speakers. Routes through WhisperX; falls back to "
                         "faster-whisper without tags if pyannote import drifts.")
    ap.add_argument("--model", default="large-v3")
    ap.add_argument("--out", type=Path, default=None,
                    help="Output JSON path. Default: <input>.transcript.json")
    args = ap.parse_args()

    if not args.input.exists():
        print(f"input not found: {args.input}", file=sys.stderr)
        return 2

    out_path = args.out or args.input.with_suffix(args.input.suffix + ".transcript.json")

    if args.diarize:
        rc = run_whisperx_with_diarize(args.input, args.language, args.model, out_path)
        if rc == 0:
            return 0
        print("[asr] falling back to faster-whisper without diarization", file=sys.stderr)

    return run_faster_whisper(args.input, args.language, args.model, out_path)


if __name__ == "__main__":
    sys.exit(main())
