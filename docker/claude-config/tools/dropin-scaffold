#!/usr/bin/env python3
"""dropin-scaffold — generate a drop-in scaffold for a blocked external asset.

When the agent can't autonomously fetch an asset (classifier denial,
license review needed, official-source-only policy), it calls this to
create:

  1. /assets/<id>/<asset-type>/  with a README naming sources + unblock paths
  2. /work/<slug>/edit/add_<asset-type>.py  merge script template
  3. manifest.<asset-type>.pending_dropin = true

Then the agent continues with everything else. When the user drops the
file at the path, the next loop tick runs the merge script.

Usage:
  dropin-scaffold <project-slug> <asset-type> [--sources <url1,url2,...>]
                                              [--notes <free-text>]

Supported asset types (extend ASSET_TYPES dict to add more):
  music       — track for video mix
  logo        — brand mark / wordmark
  license-doc — signed license / sync clearance PDF
  voiceover   — pre-recorded VO stem
  client-footage — additional source clips post-EDL
  supers      — lower-third / supers / on-screen text PNGs (alpha)
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from string import Template

