#!/usr/bin/env python3
"""burn-subtitles — drawtext-based subtitle burn-in.

Replaces the ASS-via-`subtitles` filter approach as the FSH default. Why:
the smoke test (May 2026) caught the ASS path silently ignoring its
PlayResY anchor — the money-line caption rendered at ~40% of frame
height regardless of the FontSize value, because PlayResY=288 collided
with a 1080x1920 vertical output. Worked around by switching to drawtext
mid-render. Promoting drawtext to default so it doesn't happen again.

drawtext is verbose but predictable:
  * fontsize is in output pixels — what you ask is what you get
  * UTF-8 / diacritics render via fontfile_path (no PlayResX/Y dance)
  * lower-third anchor is `y = h - margin_v_px` directly

Usage:
  burn-subtitles <input.mp4> <input.srt> <output.mp4>
                 [--font /path/to/font.ttf]
                 [--font-size-frac 0.034]  # of output height
                 [--margin-v-frac 0.10]    # bottom safe-zone
                 [--style cinema|news|kinetic]

Hard Rule 1 is preserved: this is the LAST filter chain applied — the
input is expected to already have overlays composited.
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

PRESETS_PATH = Path("/opt/claude-config/delivery-presets.json")


def load_preset(preset_name: str) -> dict:
    """Return the preset dict from delivery-presets.json, or {} if missing."""
    if not PRESETS_PATH.exists():
        return {}
    data = json.loads(PRESETS_PATH.read_text())
    return data.get("presets", {}).get(preset_name, {})

# Default fonts we look up in order. First hit wins.
FONT_CANDIDATES = [
    "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/noto/NotoSans-Bold.ttf",
    "/usr/share/fonts/TTF/Helvetica.ttf",
]

STYLE_PRESETS = {
    # name: (fontcolor, boxcolor@a, boxborderw_frac_of_fontsize)
    "cinema":  ("white", "black@0.62", 1.0),
    "news":    ("white", "black@0.85", 0.8),
    "kinetic": ("yellow", "black@0.55", 1.2),
}


def find_font() -> str:
    for p in FONT_CANDIDATES:
        if Path(p).exists():
            return p
    out = subprocess.run(
        ["fc-match", "-f", "%{file}", "DejaVu Sans:bold"],
        capture_output=True, text=True,
    )
    if out.returncode == 0 and out.stdout.strip():
        return out.stdout.strip()
    raise SystemExit("burn-subtitles: no font found (install ttf-dejavu)")


def probe_height(video: Path) -> int:
    out = subprocess.run(
        [
            "ffprobe", "-v", "error",
            "-select_streams", "v:0",
            "-show_entries", "stream=height",
            "-of", "csv=p=0", str(video),
        ],
        capture_output=True, text=True, check=True,
    )
    return int(out.stdout.strip())


SRT_TIME = re.compile(r"(\d{2}):(\d{2}):(\d{2})[,.](\d{3})")


def srt_to_seconds(s: str) -> float:
    h, m, sec, ms = SRT_TIME.match(s).groups()
    return int(h) * 3600 + int(m) * 60 + int(sec) + int(ms) / 1000.0


def parse_srt(srt_path: Path) -> list[tuple[float, float, str]]:
    cues: list[tuple[float, float, str]] = []
    block: list[str] = []
    for line in srt_path.read_text(encoding="utf-8").splitlines() + [""]:
        if line.strip() == "":
            if len(block) >= 2:
                # block[0] is index; block[1] is timestamp; rest is text
                ts = block[1]
                a, _, b = ts.partition("-->")
                start = srt_to_seconds(a.strip())
                end = srt_to_seconds(b.strip())
                text = "\n".join(block[2:]).strip()
                if text:
                    cues.append((start, end, text))
            block = []
        else:
            block.append(line)
    return cues


# ffmpeg drawtext metacharacters that need escaping inside the `text=` arg.
def drawtext_escape(text: str) -> str:
    text = text.replace("\\", r"\\")
    text = text.replace(":", r"\:")
    text = text.replace("'", r"\'")
    text = text.replace("%", r"\%")
    return text


def build_filter_chain(
    cues: list[tuple[float, float, str]],
    fontfile: str,
    height: int,
    font_size_frac: float,
    margin_v_frac: float,
    style: str,
) -> str:
    fontcolor, boxcolor, border_frac = STYLE_PRESETS[style]
    fontsize = max(18, int(round(height * font_size_frac)))
    boxborderw = max(6, int(round(fontsize * border_frac)))
    margin_v = int(round(height * margin_v_frac))
    y_expr = f"h-{margin_v}-text_h"

    parts = []
    for start, end, text in cues:
        escaped = drawtext_escape(text)
        parts.append(
            "drawtext="
            f"fontfile='{fontfile}':text='{escaped}':"
            f"fontcolor={fontcolor}:fontsize={fontsize}:"
            f"x=(w-text_w)/2:y={y_expr}:"
            f"box=1:boxcolor={boxcolor}:boxborderw={boxborderw}:"
            f"enable='between(t,{start:.3f},{end:.3f})'"
        )
    return ",".join(parts) if parts else "null"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("input", type=Path)
    ap.add_argument("srt", type=Path)
    ap.add_argument("output", type=Path)
    ap.add_argument("--font", default=None)
    ap.add_argument("--font-size-frac", type=float, default=0.034,
                    help="Caption height as fraction of output height (default 3.4%%).")
    ap.add_argument("--margin-v-frac", type=float, default=None,
                    help="Bottom margin as fraction of output height. If unset and "
                         "--preset is given, derived from the preset's safe_zone.")
    ap.add_argument("--preset", default=None,
                    help="Read safe-zone + subtitle_y_anchor from /opt/claude-config/delivery-presets.json")
    ap.add_argument("--style", choices=sorted(STYLE_PRESETS.keys()), default="cinema")
    ap.add_argument("--codec", default="libx264")
    ap.add_argument("--crf", default="18")
    args = ap.parse_args()

    # Resolve margin_v from preset's safe_zone if not explicitly set.
    margin_v_frac = args.margin_v_frac
    if margin_v_frac is None and args.preset:
        preset = load_preset(args.preset)
        # Prefer explicit subtitle_y_anchor_pct (where caption baseline sits),
        # else use safe_zone.bottom_pct as the margin floor.
        anchor = preset.get("subtitle_y_anchor_pct")
        if anchor is not None:
            # Place text TOP at this fraction of height; convert to bottom margin
            # (rough — drawtext anchors text top by default with y= expr).
            margin_v_frac = max(0.05, 1.0 - (anchor / 100.0) - 0.05)
        elif preset.get("safe_zone", {}).get("bottom_pct"):
            margin_v_frac = preset["safe_zone"]["bottom_pct"] / 100.0
    if margin_v_frac is None:
        margin_v_frac = 0.10  # legacy default

    if not args.input.exists():
        print(f"input not found: {args.input}", file=sys.stderr)
        return 2
    if not args.srt.exists():
        print(f"srt not found: {args.srt}", file=sys.stderr)
        return 2

    fontfile = args.font or find_font()
    height = probe_height(args.input)
    cues = parse_srt(args.srt)
    if not cues:
        print("burn-subtitles: srt has no cues, copying video through", file=sys.stderr)
        shutil.copyfile(args.input, args.output)
        return 0

    chain = build_filter_chain(
        cues, fontfile, height,
        args.font_size_frac, margin_v_frac, args.style,
    )

    cmd = [
        "ffmpeg", "-y",
        "-i", str(args.input),
        "-vf", chain,
        "-c:v", args.codec, "-preset", "fast", "-crf", args.crf,
        "-pix_fmt", "yuv420p",
        "-c:a", "copy",
        "-movflags", "+faststart",
        str(args.output),
    ]
    print("$ " + " ".join(cmd), file=sys.stderr)
    return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
