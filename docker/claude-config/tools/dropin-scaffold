README_TEMPLATE = Template(
    """# Drop $asset_type_pretty here

Place the asset(s) here. Expected filename pattern: `$drop_filename_glob`.

## What happens once it lands

The merge script at `$merge_script_path` reads the dropped file and
merges it into the corresponding deliverable(s): $merges_into.

To run after dropping a file:

    python $merge_script_path $drop_dir/$drop_example

The pipeline's next loop tick will pick this up automatically; running
the command yourself just makes it immediate.

## Two ways to unblock

1. **Authorize a specific URL** — name ONE specific URL and the agent
   fetches it. Single-URL specificity is much cleaner classifier
   signal than "any $asset_type_pretty from <category>". Candidate URLs:
$source_list

2. **Drop a file** — save the asset at `$drop_dir/$drop_example` from
   your phone or laptop. Under 30 seconds end-to-end once the file is
   in place.

## License / source notes

$license_note

$notes
"""
)


MERGE_SCRIPT_TEMPLATE = '''#!/usr/bin/env python3
