# Build context is the FotoStudioH root (see docker-compose.yml: context: ..).
# The Dockerfile only COPIES:
#   - agents/system-packages.txt
#   - docker/claude-config/
# Everything else is bind-mounted at runtime; keep it out of the build context
# so buildkit doesn't ship 11+ GB to the daemon on every rebuild.

agents/*
!agents/system-packages.txt

reference/
work/
assets/
.git/
