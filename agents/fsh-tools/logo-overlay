#!/usr/bin/env python3
"""logo-overlay — composite a brand logo onto an existing render.

Lives in /agents/fsh-tools/ (the self-extension surface) so it persists
across image rebuilds and is on PATH for every project.

Default usage: place a brand-lockup PNG into the top-left corner at
~10% of the frame width as a persistent corner bug, AND scale it up
~3x for the last 2.5 seconds as a close-card-grade mark. Fully covers
typographic fallbacks the renderer may have drawn at the same anchor.

Usage:
  logo-overlay <input.mp4> <logo.png> <output.mp4>
               [--bug-w-pct 10]            # corner-bug width % of frame
               [--bug-pad-pct 4]           # corner-bug padding %
               [--close-w-pct 35]          # close-card mark width %
               [--close-anchor center]     # center | bottom
               [--close-duration 2.5]      # last N seconds get the big mark
               [--no-bug]                  # skip the persistent corner bug
               [--no-close]                # skip the close-card upscale

Exit 0 on success; 2 on bad usage; 1 on ffmpeg failure.
"""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


def probe(video: Path) -> tuple[int, int, float]:
    """Return (width, height, duration_s)."""
    out = subprocess.run(
        [
            "ffprobe", "-v", "error",
            "-select_streams", "v:0",
            "-show_entries", "stream=width,height",
            "-show_entries", "format=duration",
            "-of", "default=nw=1:nk=1",
            str(video),
        ],
        capture_output=True, text=True, check=True,
    )
    lines = [l for l in out.stdout.strip().split("\n") if l]
    w = int(lines[0])
    h = int(lines[1])
    d = float(lines[2])
    return w, h, d


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("input", type=Path)
    ap.add_argument("logo", type=Path)
    ap.add_argument("output", type=Path)
    ap.add_argument("--bug-w-pct", type=float, default=10.0)
    ap.add_argument("--bug-pad-pct", type=float, default=4.0)
    ap.add_argument("--close-w-pct", type=float, default=35.0)
    ap.add_argument("--close-anchor", choices=["center", "bottom"], default="center")
    ap.add_argument("--close-duration", type=float, default=2.5)
    ap.add_argument("--no-bug", action="store_true")
    ap.add_argument("--no-close", action="store_true")
    args = ap.parse_args()

    if not args.input.exists():
        print(f"input not found: {args.input}", file=sys.stderr)
        return 2
    if not args.logo.exists():
        print(f"logo not found: {args.logo}", file=sys.stderr)
        return 2

    w, h, dur = probe(args.input)
    bug_w = int(round(w * args.bug_w_pct / 100))
    bug_pad = int(round(w * args.bug_pad_pct / 100))
    close_w = int(round(w * args.close_w_pct / 100))
    close_start = max(0.0, dur - args.close_duration)

    # Two scaled logo streams (bug + close), each composited with timing.
    # Filter graph:
    #   [1:v]scale=bug_w:-1[bug];
    #   [1:v]scale=close_w:-1[close];
    #   [0:v][bug]overlay=x=bug_pad:y=bug_pad:enable='gte(t,0)'[a];
    #   [a][close]overlay=x=(W-w)/2:y=close_anchor_expr:enable='gte(t,close_start)'[out]
    if args.close_anchor == "center":
        close_y_expr = "(H-h)/2"
    else:  # bottom
        close_y_expr = f"H-h-{int(h*0.10)}"  # 10% bottom margin

    layers = []
    if not args.no_bug:
        layers.append(f"[1:v]scale={bug_w}:-1[bug]")
    if not args.no_close:
        layers.append(f"[1:v]scale={close_w}:-1[close]")

    if not layers:
        print("nothing to do (both --no-bug and --no-close passed)", file=sys.stderr)
        return 2

    chain_parts = list(layers)
    current = "[0:v]"
    if not args.no_bug:
        chain_parts.append(
            f"{current}[bug]overlay=x={bug_pad}:y={bug_pad}[withbug]"
        )
        current = "[withbug]"
    if not args.no_close:
        chain_parts.append(
            f"{current}[close]overlay="
            f"x=(W-w)/2:y={close_y_expr}:"
            f"enable='gte(t,{close_start:.2f})'[out]"
        )
        out_label = "[out]"
    else:
        # When close is skipped, the last labelled stream is the final
        chain_parts[-1] = chain_parts[-1].replace("[withbug]", "[out]")
        out_label = "[out]"

    filter_complex = ";".join(chain_parts)
    cmd = [
        "ffmpeg", "-y", "-loglevel", "error",
        "-i", str(args.input),
        "-loop", "1", "-i", str(args.logo),
        "-filter_complex", filter_complex,
        "-map", out_label,
        "-map", "0:a?",
        "-c:v", "h264_nvenc", "-preset", "p5", "-rc", "vbr", "-cq", "20",
        "-b:v", "0", "-pix_fmt", "yuv420p",
        "-c:a", "copy",
        "-movflags", "+faststart",
        "-shortest",
        str(args.output),
    ]
    print("$ " + " ".join(cmd), file=sys.stderr)
    r = subprocess.run(cmd)
    if r.returncode != 0:
        # Fallback to libx264 if NVENC isn't available
        cmd[cmd.index("h264_nvenc")] = "libx264"
        cmd[cmd.index("-preset") + 1] = "fast"
        cmd[cmd.index("-rc")] = "-crf"
        cmd[cmd.index("-cq")] = "18"
        # Strip the vbr/b:v args that don't apply to libx264
        cmd = [a for a in cmd if a not in ("vbr", "-b:v", "0")]
        print("nvenc failed, retrying with libx264", file=sys.stderr)
        r = subprocess.run(cmd)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
